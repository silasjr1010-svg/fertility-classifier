# Copy this file to .streamlit/secrets.toml for LOCAL testing (never commit that file).
# On Streamlit Community Cloud, paste this same content into:
#   App settings -> Secrets
# instead of using a file at all.

[users.admin]
password = "change-me-admin"
role = "admin"

[users.researcher]
password = "change-me-researcher"
role = "researcher"
